# API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional: for Whisper STT
HUGGINGFACE_TOKEN=your_hf_token_here  # Optional: for private models

# LLM Configuration
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_MAX_LENGTH=512
LLM_TEMPERATURE=0.1

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Vector Database
CHROMA_COLLECTION_NAME=multilingual_audio_docs
TOP_K_RETRIEVAL=10

# Reranker
USE_RERANKER=True
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=5

# Guardrails Thresholds
CONFIDENCE_THRESHOLD=0.4
GROUNDING_THRESHOLD=0.5
CONTEXT_QUALITY_THRESHOLD=0.3

# Self-Correction
MAX_RETRIES=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Performance
BATCH_SIZE=32
MAX_WORKERS=4

# Audio
STT_MODEL=whisper-1
USE_LOCAL_WHISPER=False
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
TTS_LANGUAGE=en

# Paths (relative to project root)
DATA_DIR=data
AUDIO_DIR=data/audio_samples
CHROMA_DB_DIR=data/chroma_db
TTS_OUTPUT_DIR=data/tts_output
